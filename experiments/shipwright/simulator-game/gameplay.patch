 void SaveManager::CopyZeldaFile(int from, int to) {
+#ifdef RECOMPTV_TVOS
+    ThreadPoolWait();
+    if (from == to) return;
+    std::ifstream input(GetFileName(from), std::ios::binary);
+    if (!input) return;
+    const std::string contents((std::istreambuf_iterator<char>(input)), std::istreambuf_iterator<char>());
+    if (input.bad() || !WriteFileSafely(GetFileName(to), contents)) return;
+#else
     assert(std::filesystem::exists(GetFileName(from)));
     DeleteZeldaFile(to);
 #if defined(__WIIU__) || defined(__SWITCH__)
@@ -2494,13 +2508,19 @@
 #else
     std::filesystem::copy_file(GetFileName(from), GetFileName(to));
 #endif
+#endif
     fileMetaInfo[to] = fileMetaInfo[from];
 }

 void SaveManager::DeleteZeldaFile(int fileNum) {
+#ifdef RECOMPTV_TVOS
+    ThreadPoolWait();
+    if (!RecompTVDeleteSave(GetFileName(fileNum))) return;
+#else
     if (std::filesystem::exists(GetFileName(fileNum))) {
         std::filesystem::remove(GetFileName(fileNum));
     }
+#endif
     fileMetaInfo[fileNum].valid = false;
     fileMetaInfo[fileNum].quest = QUEST_NORMAL;
     fileMetaInfo[fileNum].requiresMasterQuest = false;
