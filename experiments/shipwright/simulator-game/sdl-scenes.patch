+#ifdef RECOMPTV_TVOS_SCENES
+/* RecompTV simulator adapter: start SDL only after UIKit connects its scene. */
+@interface RecompTVGameSceneDelegate : NSObject <UIWindowSceneDelegate>
+@end
+
+@implementation RecompTVGameSceneDelegate
+- (void)sceneDidBecomeActive:(UIScene *)scene
+{
+    static BOOL started = NO;
+    if (!started) {
+        started = YES;
+        SDLUIKitDelegate *delegate = (SDLUIKitDelegate *)UIApplication.sharedApplication.delegate;
+        [delegate performSelector:@selector(postFinishLaunch) withObject:nil afterDelay:0.0];
+    }
+}
+@end
+#endif
