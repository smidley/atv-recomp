+
+void GfxRenderingAPIMetal::TrackTimingBuffer(MTL::CommandBuffer* buffer) {
+    if (mCollectCurrentTiming) mCurrentTimingBuffers.push_back(buffer->retain());
+}
+
+void GfxRenderingAPIMetal::CollectFrameTimings() {
+    while (!mPendingFrameTimings.empty()) {
+        auto& frame = mPendingFrameTimings.front();
+        bool complete = true, valid = true;
+        double milliseconds = 0;
+        for (auto* buffer : frame.buffers) {
+            const auto status = buffer->status();
+            if (status != MTL::CommandBufferStatusCompleted && status != MTL::CommandBufferStatusError) {
+                complete = false;
+                break;
+            }
+            const double start = buffer->GPUStartTime(), end = buffer->GPUEndTime();
+            valid &= status == MTL::CommandBufferStatusCompleted && start > 0 && end > start;
+            milliseconds += (end - start) * 1000.0;
+        }
+        if (!complete) break;
+        if (valid) {
+            mLatestTimingSequence = frame.sequence;
+            mLatestGpuMilliseconds = milliseconds;
+            mLatestTimingHeight = frame.renderHeight;
+        }
+        for (auto* buffer : frame.buffers) buffer->release();
+        mPendingFrameTimings.pop_front();
+    }
+}
