 // MARK: - Helpers
 namespace Fast {
+
+// Pipeline objects are immutable and can be reused across frames.
+ShaderProgramMetal::~ShaderProgramMetal() {
+    for (auto* pipeline : pipeline_state_variants) {
+        if (pipeline) pipeline->release();
+    }
+    if (pipelineDescriptor) pipelineDescriptor->release();
+}
+
+GfxRenderingAPIMetal::~GfxRenderingAPIMetal() {
+    if (mDepthComputePipelineState) mDepthComputePipelineState->release();
+}
+
+MTL::RenderPipelineState* GfxRenderingAPIMetal::GetPipelineState(ShaderProgramMetal& program, uint32_t samples) {
+    if (samples == 0 || samples > METAL_MAX_MULTISAMPLE_SAMPLE_COUNT || !mMsaaNumQualityLevels[samples - 1]) {
+        throw std::runtime_error("Unsupported Metal sample count");
+    }
+    auto*& pipeline = program.pipeline_state_variants[samples];
+    if (!pipeline) {
+        NS::Error* error = nullptr;
+        program.pipelineDescriptor->setSampleCount(samples);
+        pipeline = mDevice->newRenderPipelineState(program.pipelineDescriptor, &error);
+        if (!pipeline) {
+            SPDLOG_ERROR("Metal pipeline creation failed: {}", error ? error->localizedDescription()->utf8String() : "unknown error");
+            throw std::runtime_error("Could not create Metal pipeline");
+        }
+    }
+    return pipeline;
+}
+
+// Simulator does not expose depth-clip-mode control, even when its host GPU does.
+// Leave the default clipping mode there and on older Apple GPU families.
+static void ConfigureDepthClipping(MTL::Device* device, MTL::RenderCommandEncoder* encoder) {
+#if !TARGET_OS_SIMULATOR
+    if (device->supportsFamily(MTL::GPUFamilyApple3) || device->supportsFamily(MTL::GPUFamilyMac2)) {
+        encoder->setDepthClipMode(MTL::DepthClipModeClamp);
+    }
+#endif
+}
 
