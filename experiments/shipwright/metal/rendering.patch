 // MARK: - ImGui & SDL Wrappers
 
+namespace {
+template <typename T> void ReleaseMetal(T*& object) {
+    if (object != nullptr) {
+        object->release();
+        object = nullptr;
+    }
+}
+
+void ConfigureDepthClipMode(MTL::RenderCommandEncoder* encoder) {
+#if TARGET_OS_TV && TARGET_OS_SIMULATOR
+    // The simulator rejects depth clamping. Keep Metal's default clipping;
+    // game near/far-plane fidelity requires a separate validation step.
+    (void)encoder;
+#else
+    encoder->setDepthClipMode(MTL::DepthClipModeClamp);
+#endif
+}
+}
+
+GfxRenderingAPIMetal::~GfxRenderingAPIMetal() {
+    // Finish any partially encoded frame before placing queue-drain barriers.
+    // Destruction, like all rendering operations here, belongs to the render thread.
+    for (auto& fb : mFramebuffers) {
+        if (fb.mCommandBuffer && fb.mCommandBuffer->status() < MTL::CommandBufferStatusCommitted) {
+            if (fb.mCommandEncoder && !fb.mHasEndedEncoding) {
+                fb.mCommandEncoder->endEncoding();
+            }
+            fb.mCommandBuffer->commit();
+        }
+    }
+    NS::AutoreleasePool* pool = NS::AutoreleasePool::alloc()->init();
+    for (auto* queue : {mCommandQueue, mReadbackQueue}) {
+        if (queue) {
+            auto* barrier = queue->commandBuffer();
+            barrier->commit();
+            barrier->waitUntilCompleted();
+        }
+    }
+    ReleaseMetal(mLastSubmittedFrame);
+    ReleaseMetal(mScreenReadbackCmdBuf);
+    ReleaseMetal(mScreenReadbackBuffer);
+    for (auto& [key, program] : mShaderProgramPool) {
+        for (auto*& pipeline : program.pipeline_state_variants) ReleaseMetal(pipeline);
+    }
+    for (auto& fb : mFramebuffers) {
+        ReleaseMetal(fb.mRenderPassDescriptor);
+        ReleaseMetal(fb.mDepthTexture);
+        ReleaseMetal(fb.mMsaaDepthTexture);
+        delete fb.mScissorRect;
+        delete fb.mViewport;
+    }
+    for (size_t i = 0; i < mTextures.size(); ++i) {
+        // The screen texture is borrowed from CAMetalDrawable, never owned here.
+        if (i != 0) ReleaseMetal(mTextures[i].texture);
+        ReleaseMetal(mTextures[i].msaaTexture);
+        ReleaseMetal(mTextures[i].sampler);
+    }
+    for (auto*& buffer : mVertexBufferPool) ReleaseMetal(buffer);
+    ReleaseMetal(mFrameUniformBuffer);
+    ReleaseMetal(mCoordUniformBuffer);
+    ReleaseMetal(mDepthValueOutputBuffer);
+    ReleaseMetal(mDepthComputeFunction);
+    ReleaseMetal(mConvertToRgb5a1Function);
+    ReleaseMetal(mConvertToRgb5a1PipelineState);
+    ReleaseMetal(mCommandQueue);
+    ReleaseMetal(mReadbackQueue);
+    pool->release();
+    ReleaseMetal(mFrameAutoreleasePool);
+    // SDL owns the layer/device; the caller owns SDL and ImGui shutdown.
+}
+
+bool GfxRenderingAPIMetal::WaitForFrame(std::string& error) {
+    if (!mLastSubmittedFrame) {
+        error = "No Metal frame has been submitted";
+        return false;
+    }
+    mLastSubmittedFrame->waitUntilCompleted();
+    if (mLastSubmittedFrame->status() != MTL::CommandBufferStatusCompleted) {
+        auto* gpuError = mLastSubmittedFrame->error();
+        error = gpuError ? gpuError->localizedDescription()->cString(NS::UTF8StringEncoding)
+                         : "Metal command buffer did not complete";
+        return false;
+    }
+    return true;
+}
